# build artefacts are committed on purpose: Tampermonkey installs dist/bingetovlc.user.js
# straight from the repository, so a released file must be in git.
node_modules/
.worktrees/
__pycache__/
*.pyc
.pytest_cache/
*.log
.vscode/
.idea/
.DS_Store
Thumbs.db
tests/e2e/tmp/
tests/e2e/artifacts/

# The native Windows handler is built (tools/windows/build-launcher.sh, or CI)
# and published as a release artefact, not committed. The source in
# tools/windows/launcher.c is what makes it rebuildable and auditable.
tools/windows/bingetovlc-handler.exe
